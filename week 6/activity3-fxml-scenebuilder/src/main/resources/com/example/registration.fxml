
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.RegistrationController"
      alignment="CENTER"
      spacing="18">

    <padding>
        <Insets top="25" right="35" bottom="25" left="35"/>
    </padding>

    <Label text="STUDENT REGISTRATION FORM"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="15" vgap="15">

        <Label text="Student Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="nameField"
                   promptText="Enter full name"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Registration Number:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="registrationField"
                   promptText="Enter registration number"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Email Address:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="emailField"
                   promptText="Enter email address"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Course:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <ComboBox fx:id="courseComboBox"
                  promptText="Select course"
                  prefWidth="220"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>

        <Label text="Gender:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <HBox spacing="15"
              GridPane.columnIndex="1"
              GridPane.rowIndex="4">

            <RadioButton fx:id="maleRadio"
                         text="Male"
                         toggleGroup="$genderGroup"/>

            <RadioButton fx:id="femaleRadio"
                         text="Female"
                         toggleGroup="$genderGroup"/>

        </HBox>

    </GridPane>

    <fx:define>
        <ToggleGroup fx:id="genderGroup"/>
    </fx:define>

    <HBox spacing="15" alignment="CENTER">

        <Button text="Register"
                onAction="#handleRegister"
                style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>

        <Button text="Clear"
                onAction="#handleClear"/>

    </HBox>

    <Label fx:id="statusLabel"
           text="Enter your details to register."
           wrapText="true"/>

</VBox>
