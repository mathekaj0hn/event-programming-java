<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.university.MainController">

    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              style="-fx-padding: 20; -fx-background-color: #0A1045;">
            <Label text="UNIVERSITY MANAGEMENT SYSTEM"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="15"
              prefWidth="180"
              style="-fx-padding: 20; -fx-background-color: #eeeeee;">
            <Button text="Dashboard"
                    maxWidth="Infinity"
                    onAction="#showDashboard"/>
            <Button text="Manage Students"
                    maxWidth="Infinity"
                    onAction="#showStudents"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;">
            <Label text="Welcome to the University Management System"
                   style="-fx-font-size: 20px;"/>
        </StackPane>
    </center>

</BorderPane>